<Window x:Class="CameraApp.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="瞳孔对光反射分析" Height="700" Width="850"
        PreviewKeyUp="PicImage_KeyUp"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 图像显示区域 -->
        <Canvas x:Name="PicCanvas" Grid.Row="0" Grid.Column="0" Margin="10"  ClipToBounds="False"  Background="Bisque">
            <!-- 放大缩小图像
            <ScrollViewer x:Name="ScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="PicImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" MouseWheel="Img_MouseWheel" MouseDown="Img_MouseDown" MouseMove="Img_MouseMove" MouseUp="Img_MouseUp">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ScaleTf" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="TranslateTf" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </ScrollViewer> 和移动的Mouse事件 -->
            <Image x:Name="PicImage" Stretch="Uniform" Margin="10" Focusable="True" 
                   MouseMove="PicImage_MouseMove"
                   MouseLeftButtonDown="Img_MouseDown"
                   MouseRightButtonDown="Img_MouseRightDown"
                   MouseLeftButtonUp="Img_MouseUp"/>
        </Canvas>
        <Canvas x:Name="CanvasOverlay" Grid.Row="0" Grid.Column="0" Margin="10" IsHitTestVisible="False"/>
        <ListBox x:Name="ListPic" Grid.Row="0" Grid.Column="1" Margin="10" PreviewMouseDoubleClick="ListPic_PreviewMouseDoubleClick" />
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10" BorderBrush="Gray" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
            <!--
                <Button x:Name="BtnLoadImage" Content="加载图像" Margin="5" Click="BtnLoadImage_Click"/>
                <Button x:Name="BtnSaveImage" Content="保存图像" Margin="5" Click="BtnSaveImage_Click"/>
                <Button x:Name="BtnClearImage" Content="清除图像" Margin="5" Click="BtnClearImage_Click"/>
            -->
                <Button x:Name="BtnParameter" Content="设置参数" Margin="5" Click="BtnSetPara_Click"/>
                <Button x:Name="BtnAnalyze" Content="分析瞳孔反射" Margin="5" Click="BtnAnalyze_Click"/>
                <Button x:Name="BtnDebugSingle" Content="单帧调试" Margin="5" Click="BtnDebugSingle_Click"/>
             </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10" BorderBrush="Gray" BorderThickness="1">
            <Label x:Name="LabelInfo" Content="Point:" Background="LightGray" Foreground="Black" FontSize="14" Padding="5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"/>
        </Border>
    </Grid>
</Window>
