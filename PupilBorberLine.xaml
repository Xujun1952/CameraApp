<Window x:Class="CameraApp.PupilBorberLine"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="彩色线段图" Height="415" Width="515" Margin="5" Background="Gainsboro" >
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Background="AliceBlue">
            <Image x:Name="Pic" Stretch="Fill" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" Background="Beige">

            <TextBlock Text="选择分析方法：" Margin="10"/>
            <RadioButton x:Name="RadioBt1" Content="最大相邻色差法" Margin="10" VerticalAlignment="Top" Checked="RadioBt_Checked" Tag="1"/>
            <RadioButton x:Name="RadioBt2" Content="最优方差分割法" Margin="10" VerticalAlignment="Top" Checked="RadioBt_Checked" Tag="2"/>
            <RadioButton x:Name="RadioBt3" Content="红色通道阈值法" Margin="10" VerticalAlignment="Top" Checked="RadioBt_Checked" Tag="3"/>
            <RadioButton x:Name="RadioBt4" Content="K-Means聚类法" Margin="10" VerticalAlignment="Top" Checked="RadioBt_Checked" Tag="4"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Background="AntiqueWhite">
            <Button x:Name="LoadFile" Content="读入文件" Margin="10" Click="LoadFile_Click"/>
            <Button x:Name="DrawLine" Content="显示图形" Margin="10" Click="DrawLine_Click"/>
        </StackPanel>
    </Grid>
</Window>
