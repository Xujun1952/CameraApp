<Window x:Class="CameraApp.SetParam"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CameraApp"
        mc:Ignorable="d"
        Title="参数设定" Height="320" Width="430">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 参数 1：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="0" Grid.Column="0" Content="红色下限" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding MinR}" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding MinR}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <!-- 参数 2：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="1" Grid.Column="0" Content="红色上限" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding MaxR}" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding MaxR}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <!-- 参数 3：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="2" Grid.Column="0" Content="绿色下限" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding MinG}" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding MinG}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <!-- 参数 4：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="3" Grid.Column="0" Content="绿色上限" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding MaxG}" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding MaxG}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <!-- 参数 5：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="4" Grid.Column="0" Content="蓝色下限" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding MinB}" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding MinB}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <!-- 参数 6：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="5" Grid.Column="0" Content="蓝色上限" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding MaxB}" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding MaxB}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <Label Grid.Row="6" Grid.Column="0" Content="色度" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding Hess}" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding Hess}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <Label Grid.Row="7" Grid.Column="0" Content="亮度" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="1">
            <Slider Value="{Binding Brightness}" Minimum="50" Maximum="200" TickFrequency="0.5" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding Brightness}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <Label Grid.Row="8" Grid.Column="0" Content="饱和度" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="1">
            <Slider Value="{Binding Saturation}" Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding Saturation}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="BtnOk" Content="确 定" Width="80" Margin="0,0,50,0" Click="BtnOk_Click" IsDefault="True"/>
            <Button Name="BtnCancel" Content="取 消" Width="80" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
