<Window x:Class="CameraApp.SetParam"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CameraApp"
        mc:Ignorable="d"
        Title="参数设定" Height="245" Width="430">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 参数 1：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="0" Grid.Column="0" Content="累加器缩小比例" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding Dp}" Minimum="1" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding Dp}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <!-- 参数 2：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="1" Grid.Column="0" Content="圆心间最小距离" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding MinDist}" Minimum="5" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding MinDist}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <!-- 参数 3：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="2" Grid.Column="0" Content="检测边缘值" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding Param1}" Minimum="20" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding Param1}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <!-- 参数 4：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="3" Grid.Column="0" Content="累加器得票阈值" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding Param2}" Minimum="5" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding Param2}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <!-- 参数 5：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="4" Grid.Column="0" Content="检测圆最小半径" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding MinRadius}" Minimum="2" Maximum="20" TickFrequency="2" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding MinRadius}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <!-- 参数 6：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="5" Grid.Column="0" Content="检测圆最大半径" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding MaxRadius}" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding MaxRadius}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <!-- 参数 7：数值参数（用 Slider 避免输入非法字符，示例用 int） -->
        <Label Grid.Row="6" Grid.Column="0" Content="高斯模糊参数" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <Slider Value="{Binding GSparam}" Minimum="1" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" Width="180"/>
            <TextBlock Text="{Binding GSparam}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="BtnOk" Content="确 定" Width="80" Margin="0,0,50,0" Click="BtnOk_Click" IsDefault="True"/>
            <Button Name="BtnCancel" Content="取 消" Width="80" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
